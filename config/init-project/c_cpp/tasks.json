{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "mkdir -Force build; cd build; cmake .. -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ -G \\\"Unix Makefiles\\\"; make",
            },
            "linux": {
                "command": "mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Debug && make",
            },
            "osx": {
                "command": "mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Debug && make",
            },
	    "presentation": {
                "clear": true
            }
        },
        {
            "label": "build release",
            "type": "shell",
            "windows": {
                "command": "mkdir -Force build; cd build; cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ -G \\\"Unix Makefiles\\\"; make"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release && make"
                ]
            },
	    "presentation": {
                "clear": true
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "windows": {
                "command": "powershell"
            },
            "linux": {
                "command": "bash"
            },
            "args": [
                "-c",
                "rm -r build"
            ]
        },
        {
            "label": "run",
            "type": "shell",
            "windows" :{
                "command": ".\\build\\main.exe"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "./build/main"
                ]
            }
        }
    ]
}
